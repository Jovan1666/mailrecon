# 求职邮件助手 —— 环境变量示例
#
# 用法：复制成 .env 并填入你自己的值。.env 已被 .gitignore 挡住，不会进仓库。
#   cp .env.example .env
#
# 注意：本文件里所有值都是**占位符**，请勿把真实凭据提交进任何仓库。

# ---------- 收件（IMAP）----------
# 邮箱账号：QQ 邮箱通常是 QQ号@qq.com
QQ_EMAIL=your-account@qq.com
# 不是登录密码，而是在邮箱设置里生成的「授权码」（16 位左右）
QQ_AUTH_CODE=your-16-char-auth-code
IMAP_HOST=imap.qq.com
IMAP_PORT=993

# ---------- 推送（飞书）----------
# 这些值放在发送端进程能读到的地方，默认是 /home/hermes/.hermes/.env
# 应用 app id（飞书开放平台自建应用里取）
FEISHU_APP_ID=your-app-id
# 应用密钥
FEISHU_APP_SECRET=your-app-secret
# 接收消息的群/会话 id
FEISHU_HOME_CHANNEL=your-chat-id

# ---------- 模型端点 ----------
# 端点与模型 id 都不写死在源码里（供应商与模型名本身也是一条"用什么服务"的线索）。
# 留空则用 prompt_final.py 里的占位值（调不通，但结构完整）。
LLM_ENDPOINT=https://api.your-llm-provider.example.com/provider/v1/chat/completions
LLM_MODEL=your-model-name
LLM_API_KEY=your-llm-api-key

# ---------- 脱敏身份 ----------
# 身份白名单 JSON 的路径。留空则用脚本同目录的 identity.json；
# 找不到就回落到代码里内置的示例身份（全是假值）。
MASK_IDENTITY=

# ---------- 平台域名清单 ----------
# 路径。留空则用脚本同目录的 platform_domains.txt；
# 该文件已被 .gitignore 挡住（它等于"我用过哪些服务"的画像），
# 从 platform_domains.txt.example 复制一份自己填。
PLATFORM_DOMAINS_FILE=
